generator client {
  provider = "prisma-client-js"
}

// This url is used by the Prisma CLI (generate/migrate/studio) only, and always points at a
// local file — see prisma.config.ts. The actual runtime connection (which may be a remote
// Turso database in production) is built by src/lib/prisma.ts via the libSQL driver adapter,
// from TURSO_DATABASE_URL / TURSO_AUTH_TOKEN instead.
datasource db {
  provider = "sqlite"
  url      = env("LOCAL_DATABASE_URL")
}

// domain is one of the DomainKey values in src/lib/domains.ts
// (SQLite has no native enum support in Prisma, so it's a validated string)

model Admin {
  id           Int    @id @default(autoincrement())
  email        String @unique
  passwordHash String
}

model GlobalSettings {
  id              Int      @id @default(autoincrement())
  title           String   @default("My Mind In A Box")
  tagline         String   @default("")
  bio             String   @default("")
  instructionText String   @default("Click a region of the brain to wander into one of the five things I think about most.")
  email           String   @default("")
  githubUrl       String?
  linkedinUrl     String?
  twitterUrl      String?
  vscoUrl         String?
  updatedAt       DateTime @updatedAt
}

model DomainInfo {
  id          Int    @id @default(autoincrement())
  domain      String @unique
  order       Int
  label       String
  tagline     String @default("")
  description String @default("")
  colorHex    String @default("#888888")
}

model Note {
  id          Int      @id @default(autoincrement())
  domain      String
  title       String
  slug        String
  summary     String   @default("")
  content     String   @default("")
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  linksFrom   NoteLink[]       @relation("LinksFrom")
  linksTo     NoteLink[]       @relation("LinksTo")
  attachments NoteAttachment[]

  @@unique([domain, slug])
}

model NoteLink {
  id     Int  @id @default(autoincrement())
  fromId Int
  toId   Int
  from   Note @relation("LinksFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to     Note @relation("LinksTo", fields: [toId], references: [id], onDelete: Cascade)

  @@unique([fromId, toId])
}

// A file attached to a note — stored on disk under public/uploads/notes (self-hosted, no
// external service), with the DB row just tracking metadata and the path to serve it from.
model NoteAttachment {
  id        Int      @id @default(autoincrement())
  noteId    Int
  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  filename  String
  path      String
  mimeType  String
  size      Int
  createdAt DateTime @default(now())
}

// The self-hosted photo gallery — the VSCO link (GlobalSettings.vscoUrl) still works
// separately as an optional external link; this is the actual on-site gallery.
model GalleryPhoto {
  id        Int      @id @default(autoincrement())
  path      String
  caption   String   @default("")
  order     Int      @default(0)
  createdAt DateTime @default(now())
}
